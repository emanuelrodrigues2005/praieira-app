generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum InteractionType {
  CONTACT
}

enum ContactChannel {
  WHATSAPP
  PHONE
}

enum ReportReason {
  ABUSIVE_CONTENT
  SPAM
  FALSE_INFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

// ── Models ──

model Review {
  id                String       @id @default(uuid())
  workerProfileId   String       @map("worker_profile_id")
  touristUserId     String       @map("tourist_user_id")
  rating            Int
  comment           String?      @db.VarChar(1000)
  status            ReviewStatus @default(PUBLISHED)
  deletedAt         DateTime?    @map("deleted_at")
  moderationReason  String?      @db.VarChar(500) @map("moderation_reason")
  moderatedByUserId String?      @map("moderated_by_user_id")
  moderatedAt       DateTime?    @map("moderated_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@unique([workerProfileId, touristUserId])
  @@index([workerProfileId, status, createdAt])
  @@map("reviews")
}

model Interaction {
  id              String          @id @default(uuid())
  type            InteractionType @default(CONTACT)
  channel         ContactChannel
  source          String?         @db.VarChar(50)
  workerProfileId String          @map("worker_profile_id")
  touristUserId   String?         @map("tourist_user_id")
  metadata        Json?
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([workerProfileId, type, createdAt])
  @@map("interactions")
}

model Report {
  id         String       @id @default(uuid())
  reviewId   String       @map("review_id")
  userId     String       @map("user_id")
  reason     ReportReason
  details    String?      @db.VarChar(500)
  status     ReportStatus @default(PENDING)
  reviewedBy String?      @map("reviewed_by")
  reviewedAt DateTime?    @map("reviewed_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([reviewId, userId])
  @@index([status, createdAt])
  @@map("reports")
}

model OutboxEvent {
  id             String    @id
  eventName      String    @map("event_name")
  version        Int       @default(1)
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  correlationId  String    @map("correlation_id")
  producer       String    @default("service-reviews")
  actor          Json?
  payload        Json
  attempts       Int       @default(0)
  nextAttemptAt  DateTime? @map("next_attempt_at")
  publishedAt    DateTime? @map("published_at")
  lastError      String?   @db.Text @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, nextAttemptAt])
  @@map("outbox_events")
}
