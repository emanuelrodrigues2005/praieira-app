NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db_reviews?schema=public
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
RMQ_URL=amqp://guest:guest@localhost:5672
RMQ_EXCHANGE=praieira.events
CATALOG_URL=http://localhost:3002
CATALOG_REQUEST_TIMEOUT_MS=3000
CORS_ORIGIN=http://localhost:4200
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_DELAY_MS=2000
REVIEW_COMMENT_MAX_LENGTH=1000
REVIEW_EDIT_WINDOW_HOURS=24
LOG_LEVEL=debug
