NODE_ENV=development
PORT=3005
MONGO_URL=mongodb://localhost:27017/db_analytics
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
RMQ_URL=amqp://guest:guest@localhost:5672
RMQ_EXCHANGE=praieira.events
RMQ_QUEUE=analytics.events
RMQ_RETRY_EXCHANGE=praieira.retry
RMQ_RETRY_QUEUE=analytics.events.retry
RMQ_DLX=praieira.dlx
RMQ_DLQ=analytics.events.dlq
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=2000
CORS_ORIGIN=http://localhost:4200
LOG_LEVEL=debug
