# Database (test — port 5433, different DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/db_catalog_test?schema=public"

# RabbitMQ (test)
RMQ_URL="amqp://guest:guest@localhost:5673"
RMQ_EXCHANGE="praieira.events"

# JWT
JWT_SECRET="test-jwt-secret-not-for-production"
JWT_ALGORITHM="HS256"

# Server
PORT=3002
CORS_ORIGIN="http://localhost:4200"

# Outbox
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_RETRY_BASE_DELAY_MS=500
OUTBOX_LEASE_TIMEOUT_MS=5000

# Curation consumer queue
CATALOG_CURATION_QUEUE="catalog.curation.events.test"
