# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db_catalog?schema=public"

# RabbitMQ
RMQ_URL="amqp://guest:guest@localhost:5672"
RMQ_EXCHANGE="praieira.events"

# JWT
JWT_SECRET="dev-jwt-secret-change-in-production"
JWT_ALGORITHM="HS256"

# Server
PORT=3002
CORS_ORIGIN="http://localhost:4200"

# Outbox (used in later slices)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_DELAY_MS=2000
OUTBOX_LEASE_TIMEOUT_MS=30000

# Curation consumer queue (used in later slices)
CATALOG_CURATION_QUEUE="catalog.curation.events"
